#N canvas 80 80 760 540 12;
#X obj 40 80 notein;
#X obj 40 120 poly 1 1;
#X obj 40 160 pack f f f;
#X obj 40 200 route 1;
#X obj 40 240 unpack f f;
#X obj 40 280 mtof;
#X obj 40 320 osc~;
#X obj 220 280 / 127;
#X obj 220 320 pack f 5;
#X obj 220 360 line~;
#X obj 40 400 *~;
#X obj 40 440 *~ 0.6;
#X obj 40 480 dac~ 1 2;
#X text 40 25 MIDI SINE - monophonic with newest-note priority;
#X text 350 100 All MIDI channels - select routing in vcpi.;
#X text 350 140 Velocity controls amplitude / 5 ms fades.;
#X text 350 180 Full-velocity peak 0.6 before host gain.;
#X text 350 220 No GUI controls or external abstractions required.;
#X text 350 260 Standalone Pd: enable DSP and select MIDI input.;
#X connect 0 0 1 0;
#X connect 0 1 1 1;
#X connect 1 0 2 0;
#X connect 1 1 2 1;
#X connect 1 2 2 2;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 4 1 7 0;
#X connect 5 0 6 0;
#X connect 6 0 10 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 9 0 10 1;
#X connect 10 0 11 0;
#X connect 11 0 12 0;
