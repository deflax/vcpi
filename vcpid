#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
VENV_DIR="${VENV_DIR:-$ROOT_DIR/.venv}"
PYTHON_BIN="$VENV_DIR/bin/python"
REQUIREMENTS="$ROOT_DIR/requirements.txt"
INSTALLED_REQUIREMENTS="$VENV_DIR/.vcpi-requirements.txt"
PACKAGE_CONFIG="$ROOT_DIR/pyproject.toml"
INSTALLED_PACKAGE_CONFIG="$VENV_DIR/.vcpi-pyproject.toml"

export LOG_LEVEL="${LOG_LEVEL:-INFO}"

if [ ! -x "$PYTHON_BIN" ]; then
  python3 -m venv "$VENV_DIR"
  "$PYTHON_BIN" -m pip install --upgrade pip
fi

# Synchronize changed metadata/dependencies or an environment from another checkout.
# Record success only after pip completes so a failed install is retried.
if ! cmp -s "$REQUIREMENTS" "$INSTALLED_REQUIREMENTS" \
  || ! cmp -s "$PACKAGE_CONFIG" "$INSTALLED_PACKAGE_CONFIG" \
  || ! "$PYTHON_BIN" -c '
import importlib.util
from pathlib import Path
import sys
spec = importlib.util.find_spec("vcpi")
expected = Path(sys.argv[1]).resolve() / "src" / "__init__.py"
raise SystemExit(spec is None or spec.origin is None or Path(spec.origin).resolve() != expected)
' "$ROOT_DIR"; then
  "$PYTHON_BIN" -m pip install -e "$ROOT_DIR"
  cp "$REQUIREMENTS" "$INSTALLED_REQUIREMENTS"
  cp "$PACKAGE_CONFIG" "$INSTALLED_PACKAGE_CONFIG"
fi

# CMake performs an incremental build for this Python ABI and host platform.
# Build before spawning audio owners; never compile on the audio path.
"$PYTHON_BIN" "$ROOT_DIR/build_native.py"

exec "$PYTHON_BIN" -m vcpi serve "$@"
