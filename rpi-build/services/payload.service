[Unit]
Description=vcpi headless host
After=sound.target
ConditionPathExists=/root/setup.sh.done

[Service]
Environment=JACK_NO_AUDIO_RESERVATION=1
Environment=LOG_LEVEL=DEBUG
User=pi
Group=pi
# Permit selective native FIFO promotion without changing default thread policy.
LimitRTPRIO=20
WorkingDirectory=/home/pi/vcpi
RuntimeDirectory=vcpi
#ExecStartPre=/bin/sleep 10
ExecStart=/home/pi/vcpi/.venv/bin/python /home/pi/vcpi/main.py serve --sock /run/vcpi/vcpi.sock
StandardOutput=journal+console
StandardError=journal+console
Restart=always
RestartSec=10s
KillMode=process
TimeoutSec=infinity

[Install]
WantedBy=multi-user.target
